#!/usr/bin/env bash
set -euo pipefail

hyprctl monitors -j | jq -er '
  (map(select(.focused))[0] // map(select(.primary))[0] // .[0]) |
  select(. != null and .disabled != true and .dpmsStatus != false) |
  (.scale // 1) as $scale |
  (if ((.transform // 0) % 2) == 1 then [.height, .width] else [.width, .height] end) as $size |
  "\(.name) \(.x) \(.y) \(($size[0] / $scale) | round) \(($size[1] / $scale) | round)"
'
