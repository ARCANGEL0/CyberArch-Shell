#!/usr/bin/env bash
set -euo pipefail

AGS_BIN="${HOME}/.local/bin/ags"
THEME_DIR="${HOME}/.config/hypr/themes/cyberpunk"
[ -f "$THEME_DIR/core.ts" ] || THEME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CORE_TS="$THEME_DIR/core.ts"

[ -x "$AGS_BIN" ] || exit 1
[ -f "$CORE_TS" ] || exit 1

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
display="${WAYLAND_DISPLAY:-}"

if [ -z "$display" ] || [ ! -S "$runtime_dir/$display" ]; then
    display=""
    for socket in "$runtime_dir"/wayland-[0-9]*; do
        [ -S "$socket" ] || continue
        candidate="${socket##*/}"
        [[ "$candidate" =~ ^wayland-[0-9]+$ ]] || continue
        if command -v wlr-randr >/dev/null 2>&1; then
            WAYLAND_DISPLAY="$candidate" XDG_RUNTIME_DIR="$runtime_dir" wlr-randr >/dev/null 2>&1 || continue
        fi
        display="$candidate"
        break
    done
fi

[ -n "$display" ] || exit 1

# updt: wait for the display Hyprland assigned before starting the app wheel.
x11_display=""
for _ in {1..50}; do
    x11_display="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^DISPLAY=//p' | tail -n 1 || true)"
    if [[ "$x11_display" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
        x_number="${BASH_REMATCH[1]}"
        if [ -S "$runtime_dir/X11-unix/X$x_number" ] || [ -S "/tmp/.X11-unix/X$x_number" ]; then
            break
        fi
    fi
    x11_display=""
    sleep 0.1
done

x11_env=()
if [ -n "$x11_display" ]; then
    export DISPLAY="$x11_display"
    dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XAUTHORITY >/dev/null 2>&1 || true
    x11_env=("DISPLAY=$x11_display")
else
    echo "[theme] XWayland DISPLAY was not ready; the app wheel will retry when an app is launched" >> /tmp/cyberhypr-x11.log
fi

exec env XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$display" "${x11_env[@]}" GDK_BACKEND=wayland \
    "$AGS_BIN" run --gtk 3 "$CORE_TS" >/tmp/cyberhypr-debug.log 2>&1
