shaders = 4

shader0 = accumulate.slang
alias0 = accum1
scale0 = 1.0
scale_type0 = source
filter_linear0 = true

shader1 = blur_horiz.slang
alias1 = blur1
scale1 = 1.0
scale_type1 = source
filter_linear1 = true

shader2 = blur_vert.slang
alias2 = blur2
scale2 = 1.0
scale_type2 = source
filter_linear2 = true

shader3 = newpixie-crt.slang
filter_linear3 = true
scale_type3 = viewport

acc_modulate = 0.30
blur_x = 1.50
blur_y = 1.50

use_frame = 0.0
curvature = 0.0001
wiggle_toggle = 0.0
scanroll = 0.0
vignette = 0.72
ghosting = 0.35

textures = "frametexture"
frametexture = __RIO_IMAGES__/crtframe.png
frametexture_linear = true
frametexture_wrap_mode = clamp_to_border
