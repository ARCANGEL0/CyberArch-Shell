shaders = 4

shader0 = accumulate.slang
alias0 = accum1
scale0 = 1.0
scale_type0 = source
filter_linear0 = true

shader1 = blur_horiz.slang
alias1 = blur1
scale1 = 1.0
scale_type1 = source
filter_linear1 = true

shader2 = blur_vert.slang
alias2 = blur2
scale2 = 1.0
scale_type2 = source
filter_linear2 = true

shader3 = kitty-pop.slang
filter_linear3 = true
scale_type3 = viewport

acc_modulate = 0.22
blur_x = 2.20
blur_y = 2.20

vignette = 0.55
ghosting = 0.45

textures = "kittytex"
kittytex = __RIO_IMAGES__/kitty.png
kittytex_linear = true
kittytex_wrap_mode = clamp_to_border
kittytex_mipmap = false
